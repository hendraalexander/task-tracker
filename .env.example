# --- Database ---
DATABASE_URL="postgresql://atracker:atracker@127.0.0.1:5433/atracker?schema=public"

# Dipakai khusus docker-compose.staging.yml (service db).
# POSTGRES_PASSWORD="<password-alfanumerik>"

# --- Auth ---
# 32+ chars. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
SESSION_TTL_DAYS="30"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Local disk storage for attachments (MVP). Swap for S3 in production.
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_MB="25"

# --- Email (MVP stub: logs to console when unset) ---
# RESEND_API_KEY=""
# EMAIL_FROM="A Tracker <no-reply@atracker.app>"

# --- Billing (MVP: checkout simulated when unset) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_PRO=""
# STRIPE_PRICE_BUSINESS=""
